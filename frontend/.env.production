# Public API base URL baked into every release (iOS/Android/web production)
# build. No secrets here — this value ends up in the shipped JS bundle either
# way. Committed on purpose so `yarn build:ios` always talks to the real
# backend instead of whatever REACT_APP_BACKEND_URL a developer's shell has
# exported for local testing (that mismatch is what shipped a LAN dev URL to
# the App Store build on 2026-09-05).
REACT_APP_BACKEND_URL=https://kite-trivia-quest.emergent.host
